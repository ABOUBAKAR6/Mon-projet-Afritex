APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
# Clé de la porte d'accès à l'administration : /espace-client?cle=... (une clé différente par boutique)
ESPACE_CLE=

# Numéro WhatsApp de la boutique, chiffres seuls avec l'indicatif (ex. 2250700000000)
WHATSAPP_NUMERO=

# Premier compte administrateur, créé par : php artisan db:seed --class=UserSeeder --force
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=

# --- Identité de la boutique (un seul code pour toutes les boutiques) ---
# Une nouvelle boutique cliente ne change que ce bloc, APP_NAME, APP_URL,
# la base de données et WHATSAPP_NUMERO ; son logo s'envoie depuis « Mon compte » de l'admin.
# Laisser une ligne vide garde la valeur d'origine AfriTex.
BOUTIQUE_NOM=AfriTex
BOUTIQUE_SLOGAN="Tissus africains, gros et détail"
BOUTIQUE_SLOGAN_LONG="tissus africains au mètre et au rouleau"
BOUTIQUE_DESCRIPTION=
BOUTIQUE_ACCROCHE=
BOUTIQUE_MOT_FIN=
BOUTIQUE_EMAIL_CONTACT=
BOUTIQUE_EMAIL_PRIVACY=
BOUTIQUE_TELEPHONE=
BOUTIQUE_ADRESSE=

# Couleurs (#rrggbb). Vide = couleurs d'origine AfriTex (brun, brun foncé, or).
# Rôles : accent = boutons et liens (texte blanc dessus, viser un contraste 4,5:1),
# foncee = pied de page, menu admin ; seconde = accent sur fond foncé ;
# papier = fond ; surface = blocs teintés ; encre / texte / texte_doux = textes ; trait = bordures.
# Écrire la couleur entre guillemets ("#8b5a99") : un # nu ouvre un commentaire.
# Exemple, palette prune et lilas :
#   ACCENT "#8b5a99"  FONCEE "#2b1a31"  SECONDE "#c4a2cf"  PAPIER "#fcfafc"  SURFACE "#f3ecf5"
#   ENCRE "#2b1a31"  TEXTE "#6a5a71"  TEXTE_DOUX "#7b6b82"  TRAIT "#e7d9ec"
BOUTIQUE_COULEUR_ACCENT=
BOUTIQUE_COULEUR_FONCEE=
BOUTIQUE_COULEUR_SECONDE=
BOUTIQUE_COULEUR_PAPIER=
BOUTIQUE_COULEUR_SURFACE=
BOUTIQUE_COULEUR_ENCRE=
BOUTIQUE_COULEUR_TEXTE=
BOUTIQUE_COULEUR_TEXTE_DOUX=
BOUTIQUE_COULEUR_TRAIT=
